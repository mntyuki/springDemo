package com.springDemo.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;

import com.springDemo.dto.BookDto;
import com.springDemo.entity.Book;
import com.springDemo.service.BookService;

@Controller
public class BookController {

	/*コンストラクタ*/

	@Autowired
	BookService service;

	/*トップページに遷移*/

	@RequestMapping("/index") //indexにリクエストが来た際に呼び出されるメソッド
	public String index() {
		return "index";
	}

	/*本一覧を表示*/

	@GetMapping("/booklist")

	public String bookList(Model model) {

		/*serviceからbook一覧を取得*/
		List<Book> bookList = service.findAll();

		/*modelに本の一覧を設定してviewに渡す*/
		model.addAttribute("bookList", bookList);

		/*一覧画面へ遷移する*/
		return "booklist";
	}
	
	
	/*本の登録画面を表示
	 * 
	 * @param model
	 * 
	 * @return 新規登録画面
	 * */
	
	@GetMapping("/bookcreate")
	public String createBook(Model model) {
		
		/*入力用のdtoを画面に渡す*/
		model.addAttribute ("bookDto", new BookDto());
		
		return "bookcreate";
	}
	
	
	/*本の新規登録
	 * 
	 * @param model
	 * 
	 * @param bookDto
	 * 
	 * @return
	 * */
	
	/*nookcreate.htmlにポスト送信されることでメソッドが動き出す*/
	@PostMapping("/bookcreate")
	public String saveBook(@ModelAttribute @Validated BookDto bookDto, Model model ) {
		
		/*本を登録する*/
		service.insert(bookDto);
		
		
		/*書籍一覧へリダイレクト*/
		return "redirect:/booklist";
	}
		

}
