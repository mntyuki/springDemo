<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <title>書籍一覧</title>

    <!--bootstrapの読み込み-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div th:replace="share::header"></div>
    <div class="container">
        <div class="row">
            <div th:each="book : ${bookList}" th:object="${book}" class="card col-4 me-3" style="width: 16rem;">
                <div class="card-body">
                    <!--<td th:text="*{id}"></td>-->
                    <h5 class="card-title" th:text="*{title}"></h5>
                    <p class="card-text" th:text="*{price}+' 円'"></p>
                    <p class="card-text">発売日
                        <span th:text="${#dates.format(book.publishDate,'yyyy/MM/dd')}"></span>
                    </p> 
                    <p class="card-text" th:text="'著者名 '+*{author}"></p>
                </div>
            </div>
        </div>
		<a class="btn btn-primary mt-3" th:href="@{/bookcreate}">書籍の登録</a>
    </div>
</body>

</html>