<!DOCTYPE html>
<html>

<head>
	<meta charset="UTF-8">
	<title>カート詳細</title>
	
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
	<div th:replace="~{share::header}"></div>


	<head>
		<title>カート</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	</head>

	<body>

		<div class="container mt-5">
			<h2 class="mb-4 text-center">🛒 カートの中身</h2>

			<table class="table table-striped">
				<thead>
					<tr>
						<th>書籍名</th>
						<th>価格</th>
						<th>数量</th>
						<th>小計</th>
					</tr>
				</thead>
				<tbody>
					<tr th:each="item : ${cartItems}">
						<td th:text="${item.book.title}"></td>
						<td th:text="${item.book.price} + '円'"></td>
						<td th:text="${item.quantity}"></td>
						<td th:text="${item.book.price * item.quantity} + '円'"></td>
					</tr>
				</tbody>
			</table>

			<div class="text-end fs-5 fw-bold">
				合計: <span th:text="${total}"></span>円
			</div>
		</div>

	</body>

	</html>
</body>

</html>